# SomeGPT API Configuration
# Copy this file to .env.local and fill in your actual values
# NOTE: Use .env.local (gitignored) for sensitive tokens, NOT .env

# Authentication tokens (auto-extracted by npm run extract-tokens)
# These expire after ~1 hour
AUTH_TOKEN=
API_KEY=

# API Endpoint (REQUIRED)
# Get this from: npm run extract-tokens
# Or manually capture from browser DevTools Network tab
# See README.md section "How to Find the API Endpoint"
API_ENDPOINT=

# Conversation ID (OPTIONAL)
# Leave blank to auto-generate a new UUID for each test run
# Or paste an existing conversation ID from SomeGPT URL
# CONVERSATION_ID=

# Pause between prompts in minutes (default: 1)
PAUSE_MINUTES=1

# Number of parallel sessions for load testing (default: 1)
CONCURRENT_SESSIONS=1

# Test duration in minutes (0 = run once, >0 = run for duration)
DURATION_MINUTES=0
